# ==============================================================================
# Burn-In Sentinel — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Persistent SQLite Database Location
# Local Development: ./data/burnin-sentinel.db
# Railway Production: /data/burnin-sentinel.db (mounted volume)
DATABASE_URL=./data/burnin-sentinel.db

# Optional: Groq API Key (Server-Side Only for Research Assistant)
# NOTE: Core screening is fully deterministic and does NOT require this key.
GROQ_API_KEY=
